{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "version": "0.1.0",
  "description": "__MSG_extensionDescription__",
  "author": "The pasejo Authors",
  "homepage_url": "https://github.com/metio/pasejo",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "pasejo",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/pasejo-16.png",
      "32": "icons/pasejo-32.png",
      "48": "icons/pasejo-48.png",
      "128": "icons/pasejo-128.png"
    }
  },
  "icons": {
    "16": "icons/pasejo-16.png",
    "32": "icons/pasejo-32.png",
    "48": "icons/pasejo-48.png",
    "128": "icons/pasejo-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "__MSG_commandOpenPopup__"
    }
  },
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting",
    "storage"
  ]
}
