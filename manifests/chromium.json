{
  "manifest_version": 3,
  "name": "pasejo",
  "version": "0.1.0",
  "description": "Fill credentials from an age-encrypted pasejo store",
  "author": "The pasejo Authors",
  "homepage_url": "https://github.com/metio/pasejo",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "pasejo",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/pasejo-16.png",
      "32": "icons/pasejo-32.png",
      "48": "icons/pasejo-48.png",
      "128": "icons/pasejo-128.png"
    }
  },
  "icons": {
    "16": "icons/pasejo-16.png",
    "32": "icons/pasejo-32.png",
    "48": "icons/pasejo-48.png",
    "128": "icons/pasejo-128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/fill.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "activeTab",
    "nativeMessaging"
  ]
}
