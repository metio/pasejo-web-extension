{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "version": "0.1.0",
  "description": "__MSG_extensionDescription__",
  "author": "The pasejo Authors",
  "homepage_url": "https://github.com/metio/pasejo",
  "browser_specific_settings": {
    "gecko": {
      "id": "pasejo@metio.wtf",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "scripts": ["protocol.js", "background.js"]
  },
  "action": {
    "default_title": "pasejo",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/pasejo-16.png",
      "32": "icons/pasejo-32.png",
      "48": "icons/pasejo-48.png",
      "128": "icons/pasejo-128.png"
    }
  },
  "icons": {
    "16": "icons/pasejo-16.png",
    "32": "icons/pasejo-32.png",
    "48": "icons/pasejo-48.png",
    "128": "icons/pasejo-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "__MSG_commandOpenPopup__"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/fill.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage",
    "webNavigation",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": ["<all_urls>"]
}
